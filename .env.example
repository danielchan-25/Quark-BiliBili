# Optional OpenAI-compatible copywriting service. Leave blank to use local templates only.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# TypeSafe candidate screening. Without this key, promotion-candidates refuses
# to refresh so unreviewed candidates cannot be published.
TYPESAFE_API_KEY=

# Random pause between daily video rechecks (1 <= min <= max <= 60).
REVIEW_WAIT_MIN_SECONDS=10
REVIEW_WAIT_MAX_SECONDS=20

# Feishu bot. Leave blank to disable notifications locally.
FEISHU_WEBHOOK=
FEISHU_SECRET=
